# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-food-app.vercel.app

# Supabase PostgreSQL & Auth Credentials
# Found in Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Google Sheets Webhook Integration
# Deployed from google-apps-script/Code.gs
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_SHEETS_SECRET=your_secure_random_shared_secret

# Pricing & Taxes
APP_DELIVERY_FEE=4.99
APP_TAX_RATE=0.0825
